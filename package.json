{
  "name": "flinko",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-site-header.js && node scripts/build-categories.js",
    "build:categories": "node scripts/build-categories.js",
    "check": "node scripts/check-syntax.js && node scripts/check-migrations.js",
    "test:unit": "node --test \"tests/functions/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test": "npm run check && npm run test:unit && npm run test:db && npm run test:e2e",
    "test:db": "node --test \"tests/db/**/*.test.mjs\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "stripe": "^22.6.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22"
  }
}
